#. Plugin Name of the plugin
#: lokilo.php
msgid "Lokilo - Store Locator for WooCommerce"
msgstr "Lokilo - Localizador de tiendas para WooCommerce"

#. Plugin URI of the plugin
#: lokilo.php
msgid "https://plogins.com/plogins-locator/"
msgstr "https://plogins.com/plogins-locator/"

#. Description of the plugin
#: lokilo.php
msgid ""
"Show your physical store locations with a searchable list customers can "
"filter by area."
msgstr "Muestre las ubicaciones de sus tiendas físicas con una lista de búsqueda que los clientes pueden filtrar por área."

#. Author of the plugin
#: lokilo.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
#: lokilo.php
msgid "https://wppoland.com"
msgstr "https://wppoland.com"

#. translators: 1: Required PHP version, 2: Current PHP version
#: lokilo.php:56
#, php-format
msgid "Lokilo requires PHP %1$s or higher. You are running PHP %2$s."
msgstr "Lokilo requiere PHP %1$s o superior. Está ejecutando PHP %2$s."

#: lokilo.php:75
msgid "Lokilo requires WooCommerce to be installed and activated."
msgstr "Lokilo requiere que WooCommerce esté instalado y activado."

#: src/Admin/ProUpsell.php:85
msgid "Wkrótce"
msgstr "Próximamente"

#: src/Admin/ProUpsell.php:85
msgid "Coming soon"
msgstr "Próximamente"

#. translators: 1: currency symbol, 2: yearly price
#: src/Admin/ProUpsell.php:91
#, php-format
msgid "from %1$s%2$d/yr"
msgstr "desde %1$s%2$d/año"

#: src/Admin/ProUpsell.php:100
msgid "Upgrade to PRO"
msgstr "Mejora a PRO"

#: src/Admin/ProUpsell.php:101
