#: src/Admin/ProUpsell.php:91
#, php-format
msgid "from %1$s%2$d/yr"
msgstr "ab %1$s%2$d/Jahr"

#: src/Admin/ProUpsell.php:100
msgid "Upgrade to PRO"
msgstr "Auf PRO upgraden"

#: src/Admin/ProUpsell.php:101
